#!/usr/bin/env bash
# Blocks `git push` if the site doesn't build. This is the same build
# hugo.yml runs for the live deploy — a broken build here means a broken
# build there. See CLAUDE.md > Push & Deploy Governance.
#
# Enabled via: git config core.hooksPath .githooks
# Bypass (not recommended): git push --no-verify

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running hugo build check..."
log="$(mktemp)"
if ! hugo --minify --destination "$(mktemp -d)" > "$log" 2>&1; then
  echo ""
  echo "pre-push: BLOCKED — hugo build failed:"
  echo ""
  cat "$log"
  echo ""
  echo "Fix the build before pushing, or 'git push --no-verify' to bypass."
  exit 1
fi

echo "pre-push: hugo build OK"
